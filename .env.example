# ==========================================
# FREE LLM Configuration (Groq / Llama 3.3)
# ==========================================
# Get your 100% FREE key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# (Optional) OpenAI Configuration (if you prefer OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# Calendly Configuration
# ==========================================
# Get your Personal Access Token from: https://calendly.com/integrations/api_webhooks
CALENDLY_TOKEN=your_calendly_personal_access_token_here
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/ea8fa002-f469-4a32-baa1-c0b954ba5115

# ==========================================
# Flask Web App Configuration
# ==========================================
SECRET_KEY=super-secret-key-nit-surat-agent
PORT=5000
